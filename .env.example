# Copy to .env and fill only the keys you have. Never commit .env.
# Local app works without any of these — labeled fallbacks are used.
#
# Production (Railway / Render / Fly / Docker):
#   Hosts inject PORT automatically — do not set API_PORT there unless you override it.
#   APP_ORIGIN must be your public URL (https://royalgoose.com).
#   JWT_SECRET is required in production (do not leave the placeholder).
#   Club data is stored in data/db.json — attach a persistent volume at /app/data
#   or the database resets on every deploy/restart.

JWT_SECRET=change-me-in-production
API_PORT=8787
APP_ORIGIN=http://localhost:5173
DEMO_LOGIN=true

# AI (optional — local briefing engine if both absent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Stripe (optional — local checkout if absent)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_CONTINENT=
STRIPE_SUCCESS_URL=http://localhost:5173/app/billing?ok=1
STRIPE_CANCEL_URL=http://localhost:5173/app/billing?cancel=1
# Production: https://royalgoose.com/app/billing?ok=1 and ?cancel=1

# Google OAuth (optional — local club-admin login if absent)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
# Production: https://royalgoose.com/api/auth/google/callback

# Google Calendar (optional — marks events synced locally if absent)
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Email (optional — writes data/outbox.json if both absent)
RESEND_API_KEY=
MAIL_FROM=Royal Goose <noreply@royalgoose.local>
SMTP_URL=

# Video vision (optional — local clip notes if absent)
YOLO_VISION_URL=
